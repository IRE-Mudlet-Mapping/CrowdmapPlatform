{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ire-mudlet-mapping.github.io/CrowdmapPlatform/crowdmap-plugin.schema.json",
  "title": "Crowdmap plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "hooks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after-export": { "$ref": "#/$defs/command" },
        "before-publish": { "$ref": "#/$defs/command" },
        "after-publish": { "$ref": "#/$defs/command" }
      }
    },
    "dangerRules": { "$ref": "#/$defs/path" }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
    }
  }
}
